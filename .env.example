# Copy this file to .env and edit values for this installation.
# The API reads these settings inside the Docker container.

N3XUS_API_SEARXNG_URL=http://searxng:8080
N3XUS_API_SEARCH_DDG_ENABLED=true
N3XUS_API_SEARCH_VARIANT_LIMIT=5
N3XUS_API_REQUEST_TIMEOUT_SECS=25
N3XUS_API_BROWSER_FALLBACK=true
N3XUS_API_HUMAN_CHALLENGE=true
N3XUS_API_HUMAN_CHALLENGE_TIMEOUT_SECS=180
N3XUS_API_DATA_DIR=/app/data
N3XUS_API_OLLAMA_URL=http://ollama:11434
N3XUS_API_OLLAMA_MODEL=qwen3.5:27b
N3XUS_API_TRANSCRIPTION_MODEL=base
N3XUS_API_TRANSCRIPTION_DEVICE=cpu
N3XUS_API_UPLOADS_DIR=/app/data/uploads

# Optional integrations. Uncomment and configure only when needed.
# N3XUS_API_API_KEY=replace-with-a-long-random-secret
# N3XUS_API_SMTP_URL=smtp://user:password@mail.example.com:587
# N3XUS_API_SMTP_FROM=agent@example.com
# N3XUS_API_STABLE_DIFFUSION_URL=http://host.docker.internal:7860
# N3XUS_API_META_ADS_ACCESS_TOKEN=replace-with-a-meta-access-token
# N3XUS_API_TRANSCRIPTION_COMPUTE_TYPE=float16
